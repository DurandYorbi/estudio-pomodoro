<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_pomodoro"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EstudioPomodoro">
        <activity
            android:name=".controller.AmbitosActivity"
            android:exported="false"
            android:label="@string/menu_ambito"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.RegistroAmbitoActivity"
            android:exported="false"
            android:label="@string/titulo_ambito"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.PlanificarSesionActivity"
            android:exported="false"
            android:label="@string/titulo_planificar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.SesionesActivity"
            android:exported="false"
            android:label="@string/titulo_sesiones"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.DetalleSesionActivity"
            android:exported="false"
            android:label="@string/titulo_detalle"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.TemporizadorActivity"
            android:exported="false"
            android:label="@string/ver_temporizador"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.ResumenActivity"
            android:exported="false"
            android:label="@string/menu_resumen"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".controller.MainActivity"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
