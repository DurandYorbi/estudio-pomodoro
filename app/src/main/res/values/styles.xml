<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EstudioPomodoro" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorControlActivated">@color/colorPrimary</item>
    </style>
    <style name="TituloPantalla">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="EtiquetaFormulario">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="TextoNormal">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>
    <style name="BotonPrincipal" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="backgroundTint">@color/colorPrimary</item>
    </style>
</resources>
